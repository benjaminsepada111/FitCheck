rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      // Users can read and write their own user document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Users can access their own profile subcollection
      match /profile/{profileDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Users can access their own challenges
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Daily challenge logs
        match /days/{dayId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Food logs within challenges
        match /foodlogs/{logId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Milestones within challenges
        match /milestones/{milestoneId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Users can access their own other subcollections (future use)
      match /{subcollection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}